//funzione del vento: tiene conto dell'altezza più vicina all'aria moltiplichiamo il valore della forza in base alla direzione del vento e l'altezza
//F.xy=

struct ParticleStruct
{
    float3 pos;
    float3 vel;
    float3 temp;
    uint counts;
};

/*
struct MeshProperties {
    float4 color;
};

RWStructuredBuffer<MeshProperties> _Properties;
*/

RWTexture2D<uint> _grid;
RWStructuredBuffer<ParticleStruct> _dataBuffer;


//_dataBuffer[id.z].tiem id.z //così rimane sempre 1 siccome l'array ha solo un valore nel primo slot e tutti gli altri sono sempre 0

//l'equazione: "1/x"
//oppure y= x-1/-y ma è da perfezionare
//oppure y= d(distanza dove comincia esserci forza) / sqr(x)  = y = d/sqr(x)

//la grandezza della particella d'acqua sarà 0.2 quindi la formula è 0.005/x

